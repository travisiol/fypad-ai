# FYPAD — every variable the app reads. Copy to .env.local (never commit it).
# Without a value the app still runs: the matching action answers a neutral sentence
# ("Launching is not open yet.", "Generation is not available right now.") — nothing is faked.

# ── Solana
# mainnet-beta (default) | devnet — inlined in the browser bundle at build time
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Server-side cluster override for scripts/tests (defaults to NEXT_PUBLIC_SOLANA_CLUSTER)
# SOLANA_CLUSTER=devnet
# Server RPC, a keyed provider is recommended (the public endpoint rate-limits). Never sent to the browser:
# the browser reads through the same-origin relay /api/rpc (read methods only).
SOLANA_RPC_URL=

# ── Coin launches (pump.fun create_v2 signed by the creator + native fee sharing)
# Receives 20 % of every coin's creator fees (pays the AI posting + the $FYPAD buyback). Required to launch.
FYPAD_TREASURY_WALLET=
# Public address of the site: serves each coin's metadata JSON (/api/launch/<id>/metadata). Required to launch.
NEXT_PUBLIC_SITE_URL=
# The $FYPAD platform token mint. Empty = never shown, the buyback share is held (see /ledger). Never invent one.
NEXT_PUBLIC_MINT=
# Optional: a key that only pays network fees for the permissionless sweep + distribute crank (cron /api/cron/fees).
# Creators can always collect themselves from /earnings without it.
OPERATOR_SECRET_KEY=

# ── AI (server-side only)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TEXT_MODEL=gpt-5.5
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium

# ── Posting economics (defaults in src/config/fypad.ts)
# What one paid AI post costs an influencer's budget, in lamports (default 3 000 000 = 0.003 SOL)
# FYPAD_COST_PER_POST_LAMPORTS=3000000
# Budget cap in posts; treasury income above it goes to the $FYPAD buyback (default 90)
# FYPAD_BUDGET_CAP_POSTS=90

# ── Persistence (Vercel)
# Postgres (Neon / Vercel Postgres). Empty = PGlite in ./data/pglite (ephemeral /tmp on Vercel).
DATABASE_URL=
# Vercel Blob for generated images. Empty = ./data/media (ephemeral on Vercel).
BLOB_READ_WRITE_TOKEN=
# 32+ random characters (session cookie). Empty = generated once and kept in the database.
SESSION_SECRET=

# ── Operations
# Authorises /api/cron/tick and /api/cron/fees (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
# Test rigs only (npm run play): lets /api/cron/tick?at=<ms> run a tick "as if" at that time. Never in production.
# FYPAD_ALLOW_CLOCK_OVERRIDE=
# Local paths (tests/play): FYPAD_PGLITE_DIR, FYPAD_MEDIA_DIR
